
# ClassLens AI Configuration
# Note: By default, ClassLens AI operates 100% locally and offline for child privacy protection.

# Optional: Set Whisper model size ('tiny', 'base', 'small', 'medium')
# 'tiny' or 'base' recommended for CPU execution
WHISPER_MODEL_SIZE=base

# Maximum upload size in Megabytes (default: 500MB)
MAX_FILE_SIZE_MB=500

# Minimum video duration in seconds required for evaluation
MIN_DURATION_SECONDS=10

# Temporary processing directory (ephemeral storage)
TEMP_DIR=./temp_processing
